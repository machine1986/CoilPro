<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Signed vehicle commands (Tesla Vehicle Command Protocol) for CoilPro, in pure C#. Not affiliated with Tesla, Inc.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoilPro\CoilPro.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!--
    Protos copied unmodified from teslamotors/vehicle-command (Apache-2.0), see Protos/README.md.
    Generated types stay internal: they land in generic top-level namespaces (Errors, Keys, CarServer, ...)
    and are not part of CoilPro's public API.
  -->
  <ItemGroup>
    <Protobuf Include="Protos/*.proto" ProtoRoot="Protos" GrpcServices="None" Access="Internal" />
  </ItemGroup>

  <!-- Apache-2.0 §4(a): ship the license of the vendored protos with the package. -->
  <ItemGroup>
    <None Include="Protos/LICENSE" Pack="true" PackagePath="licenses/vehicle-command/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoilPro.Commands.Tests" />
  </ItemGroup>

</Project>

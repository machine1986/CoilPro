<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Coil\Coil.csproj" />
  </ItemGroup>

  <!--
    Diese Referenzen sind MINDESTVERSIONEN und bleiben bewusst auf der 8.0.x-Linie —
    passend zum niedrigsten Zielframework (net8.0). Ein net10.0-Host löst automatisch
    auf die Assemblies seines Shared Framework auf; ein net8.0-Konsument darf umgekehrt
    nicht in .NET-10-Assemblies gezogen werden.

    Die Familie muss geschlossen bleiben: entweder alle drei auf 8.0.x oder alle drei
    hochziehen, sobald net8.0 aus TargetFrameworks fällt. Nie mischen.
    .github/dependabot.yml blockt Major-Bumps für genau diese drei Pakete.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ASP.NET Core / generic-host DI extensions for Coil.NET (Tesla Fleet API SDK). Not affiliated with Tesla, Inc.</Description>
  </PropertyGroup>

</Project>

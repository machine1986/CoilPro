{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "CoilPro/CoilPro.csproj",
            "CoilPro.Commands/CoilPro.Commands.csproj",
            "CoilPro.AspNetCore/CoilPro.AspNetCore.csproj"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["*.md", "toc.yml"],
        "exclude": ["dev-testing.md"]
      },
      {
        "files": ["articles/**.md", "articles/**/toc.yml"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "CoilPro",
      "_appName": "CoilPro",
      "_appFooter": "CoilPro — unofficial, not affiliated with Tesla, Inc.",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/machine1986/CoilPro",
        "branch": "main"
      }
    }
  }
}

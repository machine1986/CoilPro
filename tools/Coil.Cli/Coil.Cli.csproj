<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Coil\Coil.csproj" />
    <ProjectReference Include="..\..\src\Coil.Commands\Coil.Commands.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>coil</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>Coil.Cli</PackageId>
    <Description>Command-line companion for Coil.NET: OAuth login (loopback redirect), key generation, and smoke tests for the Tesla Fleet API. Not affiliated with Tesla, Inc.</Description>
  </PropertyGroup>

  <!-- The tool bundles Coil.Commands (ported protocol + generated protobuf code, Apache-2.0). -->
  <ItemGroup>
    <None Include="../../src/Coil.Commands/Protos/LICENSE" Pack="true" PackagePath="licenses/vehicle-command/" Visible="false" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" Visible="false" />
  </ItemGroup>

</Project>

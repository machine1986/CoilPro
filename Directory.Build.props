<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Fehlende XML-Kommentare als Warnung, nicht als Fehler -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Paket-Metadaten (greifen nur bei packbaren Projekten) -->
  <PropertyGroup>
    <Authors>dotnet services</Authors>
    <Company>dotnet services</Company>
    <Product>Coil.NET</Product>
    <Description>Unofficial .NET SDK for the Tesla Fleet API. Not affiliated with Tesla, Inc.</Description>
    <PackageProjectUrl>https://github.com/machine1986/Coil</PackageProjectUrl>
    <RepositoryUrl>https://github.com/machine1986/Coil</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>tesla;fleet-api;ev;electric-vehicle;dotnet</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="all" />
  </ItemGroup>

</Project>

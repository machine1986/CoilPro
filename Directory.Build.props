<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    XML-Doku ist nur für die Bibliotheken unter src/ Pflicht (CS1591 = Warnung). Tests, Samples und das
    CLI-Tool haben keine öffentliche API für Konsumenten.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Paket-Metadaten (greifen nur bei packbaren Projekten) -->
  <PropertyGroup>
    <!-- Release tags look like v0.1.0-preview.1; MinVer strips the prefix. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Authors>dotnet services</Authors>
    <Company>dotnet services</Company>
    <Product>CoilPro</Product>
    <Description>Unofficial .NET SDK for the Tesla Fleet API. Not affiliated with Tesla, Inc.</Description>
    <PackageProjectUrl>https://github.com/machine1986/CoilPro</PackageProjectUrl>
    <RepositoryUrl>https://github.com/machine1986/CoilPro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>tesla;fleet-api;ev;electric-vehicle;dotnet</PackageTags>
    <!-- Dateinamen IM Paket; die Quellen liegen unter anderem Namen (siehe ItemGroup unten). -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Das Paket bekommt ein eigenes, kompakteres README.nuget.md, das als README.md ins Paket wandert;
    das Root-README.md richtet sich an Besucher des Repos.
    assets/icon.png ist das CoilPro-App-Icon (512 px); weitere Logo-Varianten in assets/logo/.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.nuget.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
  </ItemGroup>

</Project>
